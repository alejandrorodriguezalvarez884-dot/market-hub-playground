# Copy to .env and fill in. .env is ignored by git: never commit keys.

# Claude, which turns what the reader asks into changes to the board. Without a key the chat
# answers that it is not available; the board and its widgets still work. There is no spending
# cap in the service: the limit is the credit on this key's account.
ANTHROPIC_API_KEY=

# Market Hub: with its address and its session secret set, only people signed in there can use
# the tool. Without them the service is open, as on a developer's machine.
HUB_URL=
HUB_SESSION_SECRET=

# Optional
# PLAYGROUND_MODEL=claude-opus-5-5
# PLAYGROUND_EFFORT=low
# For a developer's machine only: figures made up by the code instead of Yahoo's, and a stand-in
# for the model that spends nothing and understands a handful of words.
# PLAYGROUND_SAMPLE=1
# PLAYGROUND_SCRIPTED=1
